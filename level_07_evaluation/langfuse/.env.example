# ===== Langfuse =====
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
# EU region (default). US account ho to: https://us.cloud.langfuse.com
# Self-hosted (folder 09): http://localhost:3000
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Traces ko environment ke hisaab se filter karne ke liye (lowercase, no spaces)
LANGFUSE_TRACING_ENVIRONMENT=development

# ===== OpenAI =====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ===== Capstone project (folder 10) =====
APP_ENV=development
