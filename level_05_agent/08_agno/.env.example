# ==========================================================
#  Is file ko copy karke ".env" naam do, phir apni keys daalo
#  Windows cmd:   copy .env.example .env
# ==========================================================

# Kaunsa LLM?  groq | openrouter | ollama | gemini
LLM_PROVIDER=groq

# ---- Groq (free key: https://console.groq.com/keys) ----
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ---- OpenRouter (https://openrouter.ai/keys) ----
OPENROUTER_API_KEY=
# Naam hamesha "company/model" format mein
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Ollama (local) ----
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# ---- Gemini (https://aistudio.google.com/apikey) ----
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Embeddings (Knowledge/RAG) :  fastembed (local, free) | ollama ----
EMBEDDER_PROVIDER=fastembed
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Agno telemetry band ----
AGNO_TELEMETRY=false
