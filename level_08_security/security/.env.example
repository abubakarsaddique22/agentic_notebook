# Copy this file to .env and fill in your key. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# groq (default) or ollama. Use ollama for long attack runs to avoid Groq rate limits.
LLM_PROVIDER=groq
OLLAMA_APP_MODEL=gpt-oss:20b-cloud

# Local Ollama embedding model (small, ~46MB)
EMBED_MODEL=all-minilm
